  {
    "title": "Valid Anagram",
    "slug": "valid-anagram",
    "difficulty": "EASY",
    "topic": "strings",
    "statement": "Given two strings `s` and `t`, return `true` if `t` is an anagram of `s`, and `false` otherwise.\n\nAn anagram is a word or phrase formed by rearranging the letters of a different word or phrase, using all the original letters exactly once.",
    "constraints": "- `1 <= s.length, t.length <= 5 * 10^4`\n- `s` and `t` consist of lowercase English letters.",
    "examples": [
      { "input": "s = \"anagram\", t = \"nagaram\"", "output": "true" },
      { "input": "s = \"rat\", t = \"car\"", "output": "false" }
    ],
    "hints": ["Sort both strings and compare.", "Or use a frequency count map."],
    "tags": ["Hash Table", "String", "Sorting"],
    "companies": ["Amazon", "Google"],
    "visibleTests": [
      { "input": "anagram\nnagaram", "output": "true" },
      { "input": "rat\ncar", "output": "false" }
    ],
    "hiddenTests": [
      { "input": "a\na", "output": "true" },
      { "input": "ab\nba", "output": "true" },
      { "input": "abc\ncba", "output": "true" },
      { "input": "abc\nabc", "output": "true" },
      { "input": "abc\nabcd", "output": "false" },
      { "input": "aab\naba", "output": "true" },
      { "input": "silent\nlisten", "output": "true" },
      { "input": "hello\nworld", "output": "false" }
    ],
    "timeLimit": 1000,
    "memoryLimit": 256,
    "xp": 10,
    "estimatedTime": 10,
    "license": "ORIGINAL"
  },
