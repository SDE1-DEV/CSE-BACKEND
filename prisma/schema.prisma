// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  MENTOR
  ADMIN
  MANAGER
  SUPER_ADMIN
}

// ── PRD-07: Permission Module ──────────────────────────────────────────────────
enum PermissionModule {
  LEARNING
  CODING
  PROJECTS
  PLACEMENTS
  EVENTS
  NOTIFICATIONS
  REPORTS
}

// ── PRD-07: Manager Invitation Status ─────────────────────────────────────────
enum InvitationTokenStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentType {
  NOTE
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  PROJECT
  CODING_PROBLEM
}

enum ResourceType {
  PDF
  VIDEO
  ARTICLE
  GITHUB
  DOCUMENTATION
  PRACTICE_LINK
}

// ── PRD-03 Enums ──────────────────────────────────────────────────────────────

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgrammingLanguage {
  C
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILE_ERROR
}

// ── Auth Models ───────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  fullName          String
  email             String    @unique
  passwordHash      String
  phoneNumber       String?
  profileImage      String?
  collegeName       String?
  university        String?
  branch            String?
  currentYear       Int?
  semester          Int?
  githubUrl         String?
  linkedinUrl       String?
  portfolioUrl      String?
  bio               String?
  role              Role      @default(STUDENT)
  isVerified        Boolean   @default(false)
  profileCompletion Int       @default(0)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  lessonProgress     LessonProgress[]
  bookmarks          Bookmark[]
  recentlyViewed     RecentlyViewed[]
  submissions        Submission[]
  favoriteProblems   FavoriteProblem[]
  problemDiscussions ProblemDiscussion[]

  // PRD-04 relations
  ownedTeams            Team[]             @relation("TeamOwner")
  teamMemberships       TeamMember[]       @relation("TeamMemberships")
  sentInvitations       TeamInvitation[]   @relation("InvitationSender")
  receivedInvitations   TeamInvitation[]   @relation("InvitationReceiver")
  assignedTasks         Task[]             @relation("TaskAssignee")
  uploadedProjectFiles  ProjectFile[]      @relation("ProjectFileUploader")
  teamComments          TeamComment[]      @relation("TeamCommentAuthor")
  activityLogs          ActivityLog[]      @relation("ActivityLogUser")

  // PRD-05 relations
  jobApplications    JobApplication[]
  resumes            Resume[]
  eventRegistrations EventRegistration[]
  notifications      Notification[]
  analytics          UserAnalytics?

  // PRD-07 relations
  managerPermissions    ManagerPermission[]    @relation("ManagerPermissions")
  auditLogsPerformed    AuditLog[]             @relation("AuditLogPerformer")
  roleHistories         RoleHistory[]          @relation("RoleHistoryUser")
  managerInvitationsSent ManagerInvitation[]   @relation("ManagerInvitationInviter")

  // FPRD-10 relations
  bannersCreated        Banner[]               @relation("BannerCreator")
  faqsCreated           Faq[]                  @relation("FaqCreator")
  testimonialsCreated   Testimonial[]          @relation("TestimonialCreator")
  mediaFilesUploaded    MediaFile[]            @relation("MediaFileUploader")
  contentVersions       ContentVersion[]       @relation("ContentVersionEditor")

  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

// ── Learning Ecosystem Models ─────────────────────────────────────────────────

model Category {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  description  String?
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  roadmaps Roadmap[]

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("categories")
}

model Roadmap {
  id             String     @id @default(uuid())
  categoryId     String
  title          String
  slug           String     @unique
  description    String?
  thumbnail      String?
  difficulty     Difficulty @default(BEGINNER)
  estimatedHours Int?
  prerequisites  String?
  tags           String?    // FPRD-10: comma-separated tags
  learningOutcomes String?  // FPRD-10: what students will learn
  seoTitle       String?    // FPRD-10: SEO title
  seoDescription String?    // FPRD-10: SEO description
  banner         String?    // FPRD-10: banner image URL
  visibility     String?    @default("PUBLIC") // FPRD-10: PUBLIC | PRIVATE | INVITE_ONLY
  displayOrder   Int        @default(0)
  isPublished    Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sections RoadmapSection[]

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([difficulty])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("roadmaps")
}

model RoadmapSection {
  id          String  @id @default(uuid())
  roadmapId   String
  title       String
  description String?
  order       Int     @default(0)
  deletedAt   DateTime?

  roadmap Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([roadmapId])
  @@index([order])
  @@index([deletedAt])
  @@map("roadmap_sections")
}

model Lesson {
  id               String      @id @default(uuid())
  sectionId        String
  title            String
  slug             String      @unique
  description      String?
  content          String?     // FPRD-10: rich text / markdown body (Module 1)
  contentType      ContentType @default(NOTE)
  estimatedMinutes Int?
  order            Int         @default(0)
  isPublished      Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  section        RoadmapSection   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources      LearningResource[]
  progress       LessonProgress[]
  bookmarks      Bookmark[]
  recentlyViewed RecentlyViewed[]

  @@index([slug])
  @@index([sectionId])
  @@index([isPublished])
  @@index([order])
  @@index([deletedAt])
  @@map("lessons")
}

model LearningResource {
  id        String       @id @default(uuid())
  lessonId  String
  type      ResourceType
  title     String
  url       String
  duration  Int?
  author    String?
  thumbnail String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([deletedAt])
  @@map("learning_resources")
}

model LessonProgress {
  id              String    @id @default(uuid())
  userId          String
  lessonId        String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  watchPercentage Float     @default(0)
  timeSpent       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("bookmarks")
}

model RecentlyViewed {
  id       String   @id @default(uuid())
  userId   String
  lessonId String
  viewedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("recently_viewed")
}

// ── PRD-03: Coding Practice Platform ──────────────────────────────────────────

model ProblemCategory {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  problems CodingProblem[]

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("problem_categories")
}

model CodingProblem {
  id               String            @id @default(uuid())
  categoryId       String
  title            String
  slug             String            @unique
  description      String?
  problemStatement String
  inputFormat      String?
  outputFormat     String?
  constraints      String?
  sampleInput      String?
  sampleOutput     String?
  explanation      String?
  difficulty       ProblemDifficulty @default(EASY)
  timeLimit        Int               @default(1000)   // milliseconds
  memoryLimit      Int               @default(256)    // MB
  acceptanceRate   Float             @default(0)
  points           Int               @default(0)
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  category     ProblemCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  testCases    TestCase[]
  templates    CodeTemplate[]
  submissions  Submission[]
  favorites    FavoriteProblem[]
  discussions  ProblemDiscussion[]
  tags         ProblemTagRelation[]
  companies    ProblemCompany[]
  dailyChallenges DailyChallenge[]

  @@index([categoryId])
  @@index([difficulty])
  @@index([slug])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("coding_problems")
}

model ProblemTag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  problems ProblemTagRelation[]

  @@index([slug])
  @@map("problem_tags")
}

model ProblemTagRelation {
  id        String @id @default(uuid())
  problemId String
  tagId     String

  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     ProblemTag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([problemId, tagId])
  @@index([problemId])
  @@index([tagId])
  @@map("problem_tag_relations")
}

model Company {
  id           String  @id @default(uuid())
  name         String  @unique
  slug         String  @unique
  logo         String?
  website      String?
  // PRD-05 extensions
  description  String?
  industry     String?
  headquarters String?
  careersUrl   String?
  verified     Boolean @default(false)
  deletedAt    DateTime?

  problems    ProblemCompany[]
  jobPostings JobPosting[]

  @@index([slug])
  @@index([deletedAt])
  @@map("companies")
}

model ProblemCompany {
  id        String @id @default(uuid())
  problemId String
  companyId String

  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([problemId, companyId])
  @@index([problemId])
  @@index([companyId])
  @@map("problem_companies")
}

model TestCase {
  id             String  @id @default(uuid())
  problemId      String
  input          String
  expectedOutput String
  isSample       Boolean @default(false)
  isHidden       Boolean @default(false)
  weight         Int     @default(1)

  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId])
  @@map("test_cases")
}

model CodeTemplate {
  id        String              @id @default(uuid())
  problemId String
  language  ProgrammingLanguage
  template  String

  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@index([problemId])
  @@map("code_templates")
}

model Submission {
  id              String            @id @default(uuid())
  userId          String
  problemId       String
  language        ProgrammingLanguage
  sourceCode      String
  status          SubmissionStatus  @default(PENDING)
  runtime         Int?              // milliseconds
  memoryUsed      Int?              // MB
  score           Int               @default(0)
  passedTestCases Int               @default(0)
  totalTestCases  Int               @default(0)
  submittedAt     DateTime          @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@index([submittedAt])
  @@index([status])
  @@map("submissions")
}

model FavoriteProblem {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([problemId])
  @@map("favorite_problems")
}

model DailyChallenge {
  id            String   @id @default(uuid())
  problemId     String
  challengeDate DateTime @unique @db.Date
  bonusXP       Int      @default(50)

  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([challengeDate])
  @@index([problemId])
  @@map("daily_challenges")
}

model ProblemDiscussion {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
  @@map("problem_discussions")
}

// ── PRD-04: Project Hub & Team Collaboration ───────────────────────────────────

enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum TeamStatus {
  OPEN
  FULL
  CLOSED
  COMPLETED
}

enum TeamMemberRole {
  OWNER
  LEADER
  DEVELOPER
  DESIGNER
  RESEARCHER
  TESTER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ActivityAction {
  TEAM_CREATED
  MEMBER_JOINED
  TASK_ASSIGNED
  TASK_COMPLETED
  MILESTONE_COMPLETED
  FILE_UPLOADED
  COMMENT_ADDED
  TASK_UPDATED
  MEMBER_REMOVED
  INVITATION_SENT
  INVITATION_ACCEPTED
}

model ProjectCategory {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  projects Project[]

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
  @@index([deletedAt])
  @@map("project_categories")
}

model Project {
  id               String            @id @default(uuid())
  categoryId       String
  title            String
  slug             String            @unique
  description      String?
  overview         String?
  difficulty       ProjectDifficulty @default(BEGINNER)
  estimatedDuration String?
  thumbnail        String?
  githubRepository String?
  liveDemo         String?
  documentationUrl String?
  requirements     String?
  learningOutcomes String?
  isPublished      Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  category     ProjectCategory           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  technologies ProjectTechnologyRelation[]
  teams        Team[]
  milestones   Milestone[]
  files        ProjectFile[]

  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
  @@index([difficulty])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectTechnology {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique
  icon String?

  projects ProjectTechnologyRelation[]

  @@index([slug])
  @@map("project_technologies")
}

model ProjectTechnologyRelation {
  id           String @id @default(uuid())
  projectId    String
  technologyId String

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology ProjectTechnology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@unique([projectId, technologyId])
  @@index([projectId])
  @@index([technologyId])
  @@map("project_technology_relations")
}

model Team {
  id         String     @id @default(uuid())
  projectId  String
  name       String
  ownerId    String
  maxMembers Int        @default(5)
  status     TeamStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  invitations TeamInvitation[]
  tasks       Task[]
  activityLogs ActivityLog[]

  @@index([projectId])
  @@index([ownerId])
  @@index([status])
  @@map("teams")
}

model TeamMember {
  id       String         @id @default(uuid())
  teamId   String
  userId   String
  role     TeamMemberRole @default(DEVELOPER)
  joinedAt DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id         String           @id @default(uuid())
  teamId     String
  senderId   String
  receiverId String
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender   User @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@map("team_invitations")
}

model Task {
  id             String       @id @default(uuid())
  teamId         String
  assignedTo     String?
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  dueDate        DateTime?
  estimatedHours Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  team       Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee   User?         @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  comments   TeamComment[]

  @@index([teamId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

model Milestone {
  id                   String          @id @default(uuid())
  projectId            String
  title                String
  description          String?
  dueDate              DateTime?
  status               MilestoneStatus @default(PENDING)
  completionPercentage Float           @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("milestones")
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  uploadedBy String
  title      String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User    @relation("ProjectFileUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([uploadedBy])
  @@map("project_files")
}

model TeamComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TeamCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("team_comments")
}

model ActivityLog {
  id        String         @id @default(uuid())
  teamId    String
  userId    String
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation("ActivityLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ── PRD-05: Placement Ecosystem ────────────────────────────────────────────────

enum JobType {
  INTERNSHIP
  FULL_TIME
  PART_TIME
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ApplicationStatus {
  SAVED
  APPLIED
  OA_SCHEDULED
  INTERVIEW
  HR_ROUND
  OFFERED
  REJECTED
  WITHDRAWN
}

// ── PRD-05: Events ─────────────────────────────────────────────────────────────

enum EventType {
  HACKATHON
  WEBINAR
  WORKSHOP
  CONTEST
  BOOTCAMP
  MEETUP
}

// ── PRD-05: Notifications ──────────────────────────────────────────────────────

enum NotificationType {
  PLACEMENT
  PROJECT
  CODING
  LEARNING
  EVENT
  SYSTEM
}

// ── PRD-05: Job Postings ───────────────────────────────────────────────────────

model JobPosting {
  id                  String    @id @default(uuid())
  companyId           String
  title               String
  type                JobType   @default(FULL_TIME)
  location            String?
  workMode            WorkMode  @default(ONSITE)
  description         String
  requirements        String?
  salaryRange         String?
  applicationUrl      String?
  applicationDeadline DateTime?
  experienceRequired  String?
  isPublished         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications JobApplication[]

  @@index([companyId])
  @@index([isPublished])
  @@index([applicationDeadline])
  @@index([type])
  @@index([workMode])
  @@index([deletedAt])
  @@map("job_postings")
}

model JobApplication {
  id       String            @id @default(uuid())
  userId   String
  jobId    String
  status   ApplicationStatus @default(SAVED)
  notes    String?
  appliedAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("job_applications")
}

// ── PRD-05: Resume Builder ─────────────────────────────────────────────────────

model Resume {
  id        String   @id @default(uuid())
  userId    String
  title     String
  template  String   @default("default")
  resumeUrl String?
  atsScore  Int?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections ResumeSection[]

  @@index([userId])
  @@map("resumes")
}

model ResumeSection {
  id          String   @id @default(uuid())
  resumeId    String
  sectionType String
  content     Json
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_sections")
}

// ── PRD-05: Events ─────────────────────────────────────────────────────────────

model Event {
  id              String    @id @default(uuid())
  title           String
  description     String?
  type            EventType @default(WEBINAR)
  organizer       String?
  location        String?
  startTime       DateTime
  endTime         DateTime
  registrationUrl String?
  maxParticipants Int?
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  registrations EventRegistration[]

  @@index([isPublished])
  @@index([startTime])
  @@index([type])
  @@index([deletedAt])
  @@map("events")
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  userId       String
  registeredAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

// ── PRD-05: Notifications ──────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

// ── PRD-05: User Analytics ─────────────────────────────────────────────────────

model UserAnalytics {
  id                    String    @id @default(uuid())
  userId                String    @unique
  lastLogin             DateTime?
  totalStudyMinutes     Int       @default(0)
  currentLearningStreak Int       @default(0)
  longestLearningStreak Int       @default(0)
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_analytics")
}

// ── PRD-05: Platform Settings ──────────────────────────────────────────────────

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("platform_settings")
}

// ── PRD-07: Manager Permissions ───────────────────────────────────────────────

model ManagerPermission {
  id        String           @id @default(uuid())
  managerId String
  module    PermissionModule
  canCreate Boolean          @default(false)
  canRead   Boolean          @default(true)
  canUpdate Boolean          @default(false)
  canDelete Boolean          @default(false)
  canPublish Boolean         @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  manager User @relation("ManagerPermissions", fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([managerId, module])
  @@index([managerId])
  @@index([module])
  @@map("manager_permissions")
}

// ── PRD-07: Audit Log ─────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  performedBy String
  targetUser  String?
  role        String
  action      String
  module      String?
  entity      String?
  entityId    String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  performer User  @relation("AuditLogPerformer", fields: [performedBy], references: [id], onDelete: Cascade)

  @@index([performedBy])
  @@index([targetUser])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([role])
  @@map("audit_logs")
}

// ── PRD-07: Role History ───────────────────────────────────────────────────────

model RoleHistory {
  id         String   @id @default(uuid())
  userId     String
  oldRole    String
  newRole    String
  reason     String?
  changedBy  String
  createdAt  DateTime @default(now())

  user User @relation("RoleHistoryUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("role_history")
}

// ── PRD-07: Manager Invitation ────────────────────────────────────────────────

model ManagerInvitation {
  id         String               @id @default(uuid())
  email      String
  token      String               @unique
  status     InvitationTokenStatus @default(PENDING)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime             @default(now())

  inviter User @relation("ManagerInvitationInviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([status])
  @@map("manager_invitations")
}

// ── PRD-07: Platform Metrics (Daily Snapshots) ────────────────────────────────

model PlatformMetric {
  id                  String   @id @default(uuid())
  date                DateTime @unique @db.Date
  totalUsers          Int      @default(0)
  activeUsers         Int      @default(0)
  newUsers            Int      @default(0)
  learningHours       Float    @default(0)
  codingSubmissions   Int      @default(0)
  projectsCreated     Int      @default(0)
  applications        Int      @default(0)
  eventsRegistered    Int      @default(0)
  avgSessionTime      Float    @default(0)
  storageUsed         Float    @default(0)
  apiRequests         Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([date])
  @@map("platform_metrics")
}

// ── PRD-07: System Log ────────────────────────────────────────────────────────

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  module    String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([module])
  @@index([createdAt])
  @@map("system_logs")
}

// ── FPRD-10: Banner Management ────────────────────────────────────────────────

enum BannerPlacement {
  HOMEPAGE
  LEARNING
  CODING
  PLACEMENT
  EVENTS
  ANNOUNCEMENT
}

enum BannerType {
  IMAGE
  VIDEO
}

model Banner {
  id          String          @id @default(uuid())
  title       String
  placement   BannerPlacement @default(HOMEPAGE)
  type        BannerType      @default(IMAGE)
  mediaUrl    String
  ctaText     String?
  ctaLink     String?
  priority    Int             @default(0)
  isActive    Boolean         @default(true)
  scheduledAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  creator User @relation("BannerCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([placement])
  @@index([isActive])
  @@index([priority])
  @@index([deletedAt])
  @@map("banners")
}

// ── FPRD-10: FAQ CMS ──────────────────────────────────────────────────────────

model FaqCategory {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  faqs Faq[]

  @@index([slug])
  @@map("faq_categories")
}

model Faq {
  id           String      @id @default(uuid())
  categoryId   String?
  question     String
  answer       String
  searchKeywords String?
  isPublished  Boolean     @default(false)
  displayOrder Int         @default(0)
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  category  FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  creator   User         @relation("FaqCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("faqs")
}

// ── FPRD-10: Testimonials ────────────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(uuid())
  studentName String
  studentId   String?
  role        String?
  company     String?
  content     String
  rating      Int      @default(5)
  avatarUrl   String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  creator User @relation("TestimonialCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([isFeatured])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("testimonials")
}

// ── FPRD-10: Media Library ────────────────────────────────────────────────────

enum MediaFileType {
  IMAGE
  VIDEO
  PDF
  ZIP
  DOCX
  PPT
  ICON
  OTHER
}

model MediaFile {
  id          String        @id @default(uuid())
  filename    String
  originalName String
  mimeType    String
  fileType    MediaFileType @default(OTHER)
  fileUrl     String
  fileSize    Int           @default(0)
  folder      String?
  altText     String?
  uploadedBy  String
  usageCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  uploader User @relation("MediaFileUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([uploadedBy])
  @@index([folder])
  @@index([fileType])
  @@index([deletedAt])
  @@map("media_files")
}

// ── FPRD-10: Content Version History ────────────────────────────────────────

model ContentVersion {
  id         String   @id @default(uuid())
  entity     String
  entityId   String
  version    Int      @default(1)
  editedBy   String
  fieldName  String?
  oldValue   Json?
  newValue   Json?
  changeNote String?
  createdAt  DateTime @default(now())

  editor User @relation("ContentVersionEditor", fields: [editedBy], references: [id], onDelete: Cascade)

  @@index([entity, entityId])
  @@index([editedBy])
  @@index([createdAt])
  @@map("content_versions")
}
