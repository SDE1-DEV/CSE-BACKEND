# ─────────────────────────────────────────────────────────────────────────────
# CSE Student Platform — Environment Variables
# PRD-06: Production Engineering & Scalability
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # development | staging | production | test

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-64-char-random-secret-in-production"
JWT_REFRESH_SECRET="change-this-to-a-different-64-char-random-secret"
JWT_EXPIRY="15m"
REFRESH_EXPIRY="7d"

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_NAME="CSE Student Platform"

# ── Client ────────────────────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ── Redis (PRD-06) ────────────────────────────────────────────────────────────
# Option A: Use individual settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Option B: Use connection URL (takes precedence over individual settings)
# REDIS_URL=redis://:password@localhost:6379

# ── Cache TTL (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_SHORT=300      # 5 minutes
CACHE_TTL_MEDIUM=1800    # 30 minutes
CACHE_TTL_LONG=86400     # 24 hours

# ── Email Verification (PRD-08.1) ──────────────────────────────────────────────
# false = auto-verify all registrations (development mode)
# true  = require OTP email verification before login (production mode)
ENABLE_EMAIL_VERIFICATION=false

# ── FPRD-17: Online Judge ──────────────────────────────────────────────────────
# Set EXECUTION_ENGINE=piston to use Piston (real judge)
# Set EXECUTION_ENGINE=mock for local dev without Piston
EXECUTION_ENGINE=mock

# Piston API (self-hosted or public)
# Public API: https://emkc.org/api/v2/piston  (rate limited)
# Self-hosted: https://github.com/engineer-man/piston
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=

# Async judge: true = queue (recommended for production), false = execute inline (dev)
JUDGE_ASYNC=true

# ── FPRD-19: Production Coding Library & Judge Stabilization ──────────────────
#
# After importing problems, run these commands in order:
#   npm run import:dataset -- --publish   # import + auto-publish all 300 problems
#   npm run link:related                  # auto-link related problems by topic/tag
#
# Judge fallback: if Redis is down, submit auto-falls-back to sync execution
# Language normalization: frontend 'python' → backend 'PYTHON' (handled automatically)
#
# Problem counts after full import:
#   Easy  : ~120 problems
#   Medium: ~173 problems
#   Total :  300 problems across 21 DSA topics
